  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:actual": "vite --config vite.actual.config.ts --host 127.0.0.1",
    "build:actual": "vue-tsc -b && vite build --config vite.actual.config.ts",
    "preview:actual": "vite preview --config vite.actual.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "three": "^0.177.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
